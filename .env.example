# Optional Gate 6 Bedrock development credential. Copy to .env only; never commit
# a real key. Long-term Bedrock API keys are for bounded development use.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
COVENANT_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Local DataHub only. Copy to .env; never commit real values.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_UI_URL=http://localhost:9002
DATAHUB_TOKEN=
DATAHUB_ENV=DEV
DATAHUB_VERSION=v1.6.0
COVENANT_PYTHON=python3.11
COVENANT_VENV=.venv
COVENANT_API_HOST=127.0.0.1
COVENANT_API_PORT=8000
COVENANT_API_URL=http://127.0.0.1:8000
COVENANT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional explicit alternate ignored state file for an isolated walkthrough:
# COVENANT_STATE_PATH=smoke-test/generated-state/gate5-browser-state.json
COVENANT_ACTOR=urn:li:corpuser:covenant_gate0_agent
COVENANT_READ_ONLY=false
